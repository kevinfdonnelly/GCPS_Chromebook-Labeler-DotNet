<Window x:Class="GCPS_Chromebook_Labeler.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GCPS Chromebook Labeler" Height="720" Width="980" MinHeight="650" MinWidth="900" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
<Grid Margin="28">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Grid.Row="0"><TextBlock Text="GCPS Chromebook Labeler" FontSize="30" FontWeight="Bold"/><TextBlock Text="DYMO LabelWriter 450 Twin Turbo" FontSize="15" Foreground="#606770" Margin="0,4,0,0"/></StackPanel>
<Border Grid.Row="1" Background="White" BorderBrush="#D8DDE5" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,18"><DockPanel><Button x:Name="RefreshPrintersButton" DockPanel.Dock="Right" Content="Refresh Printer" Width="140" Margin="14,0,0,0" Padding="10,6" Click="RefreshPrintersButton_Click"/><StackPanel><TextBlock Text="Printer Status" FontWeight="SemiBold"/><TextBlock x:Name="PrinterStatusText" Text="Checking for DYMO printer..." Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="White" BorderBrush="#D8DDE5" BorderThickness="1" CornerRadius="10" Padding="22"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Student / Chromebook Label" Style="{StaticResource SectionTitle}"/><TextBlock Text="DYMO 30336 · 1&quot; × 2-1/8&quot; · RIGHT roll" Foreground="#606770" Margin="0,0,0,18"/>
<TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StudentNameTextBox"/>
<TextBlock Text="Student ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StudentIdTextBox"/>
<TextBlock Text="Chromebook ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ChromebookIdTextBox"/>
<TextBlock Text="County ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="StudentCountyIdTextBox"/>
<Button x:Name="PrintStudentButton" Content="Print Student Label" Background="{StaticResource AccentBrush}" Foreground="White" Click="PrintStudentButton_Click"/>
<TextBlock x:Name="StudentMessageText" Margin="0,12,0,0" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Border>
<Border Grid.Column="2" Background="White" BorderBrush="#D8DDE5" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel>
<TextBlock Text="County ID Label" Style="{StaticResource SectionTitle}"/><TextBlock Text="DYMO 30332 · 1&quot; × 1&quot; · LEFT roll" Foreground="#606770" Margin="0,0,0,18"/>
<TextBlock Text="County ID" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CountyIdTextBox"/>
<Button x:Name="PrintCountyButton" Content="Print County Label" Background="{StaticResource AccentBrush}" Foreground="White" Click="PrintCountyButton_Click"/>
<TextBlock x:Name="CountyMessageText" Margin="0,12,0,0" TextWrapping="Wrap"/>
</StackPanel></Border>
</Grid>
<TextBlock Grid.Row="3" Text="No student or label information is stored." Foreground="#606770" Margin="0,18,0,0" HorizontalAlignment="Center"/>
</Grid>
</Window>
