<Application x:Class="GCPS_Chromebook_Labeler.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#1F5F99"/>
    <Style TargetType="TextBox"><Setter Property="FontSize" Value="16"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
    <Style TargetType="Button"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Application.Resources>
</Application>
